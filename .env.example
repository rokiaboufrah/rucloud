# Django
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=.onrender.com,.vercel.app,localhost,127.0.0.1

# Seed superuser (omit the password to generate and print a random one)
DJANGO_ADMIN_USERNAME=admin
DJANGO_ADMIN_EMAIL=admin@example.com
DJANGO_ADMIN_PASSWORD=replace-with-a-strong-password
# DJANGO_SEED_SKIP_SUPERUSER=True

# PostgreSQL (Render auto-provides DATABASE_URL)
DATABASE_URL=postgres://user:pass@host:5432/rucloud

# Frontend / CORS / CSRF
FRONTEND_URL=https://rucloud.vercel.app
CORS_ALLOWED_ORIGINS=https://rucloud.vercel.app
CSRF_TRUSTED_ORIGINS=https://rucloud.vercel.app
EXTRA_ALLOWED_ORIGINS=
# Set this in the Vercel project (frontend build), not on Render:
VITE_API_URL=https://rucloud-api.onrender.com/api

# Email (console backend is safe locally; configure SMTP in production)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=Ru Cloud <no-reply@rucloud.dz>
ADMIN_EMAIL=admin@example.com
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False

# BaridiMob (placeholders - supply real values via the environment)
BARIDIMOB_PHONE=YOUR_BARIDIMOB_PHONE
BARIDIMOB_NAME=YOUR_BARIDIMOB_NAME

# CCP (placeholders - supply real values via the environment)
CCP_ACCOUNT_HOLDER=YOUR_CCP_ACCOUNT_HOLDER
CCP_ACCOUNT_NUMBER=YOUR_CCP_ACCOUNT_NUMBER
CCP_CLE=YOUR_CCP_CLE
CCP_BANK=YOUR_BANK_NAME
CCP_ADDRESS=YOUR_BANK_ADDRESS
